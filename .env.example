# Database (used by docker-compose services; server gets DATABASE_URL from compose)
# DATABASE_URL is required for local dev without docker (prod compose overrides it)
DATABASE_URL="postgresql://vitori:vitori@localhost:5432/vitoribot"
POSTGRES_USER="vitori"
POSTGRES_PASSWORD="change-me-strong-random"
POSTGRES_DB="vitoribot"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Telegram
BOT_TOKEN="1234567890:ABC..."
WEBHOOK_SECRET="64-char-random-hex-change-me-00000000000000000000000000000000"
BOT_WEBHOOK_URL="https://bot.yourdomain.com/webhook"
MINIAPP_URL="https://miniapp.yourdomain.com"

# Storage
# Today only "local" is implemented: receipt photos are saved on disk
# at STORAGE_LOCAL_PATH (a docker volume in production). Leave as-is.
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="/app/uploads"
# MinIO (S3-compatible) is provisioned by docker-compose for future use.
# The app does not read these yet — they only set the MinIO container login.
# Generate with: openssl rand -hex 12
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="change-me-min-8-chars"
MINIO_BUCKET="vitoribot"

# App
NODE_ENV="development"
LOG_LEVEL="debug"
API_PORT=3001
WEB_PORT=3000

# Web admin panel (NextAuth). NEXTAUTH_SECRET: openssl rand -hex 32
NEXTAUTH_URL="https://panel.yourdomain.com"
NEXTAUTH_SECRET="change-me-long-random-string"
# Public backend URL baked into the web/miniapp builds (rebuild after changing)
NEXT_PUBLIC_BACKEND_URL="https://bot.yourdomain.com"
VITE_API_URL="https://bot.yourdomain.com"

# Bootstrap: Telegram IDs promoted to SUPER_ADMIN on boot (comma-separated)
BOOTSTRAP_ADMIN_IDS=""
