# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/vitoribot"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Telegram
BOT_TOKEN="1234567890:ABC..."
WEBHOOK_SECRET="64-char-random-hex-change-me-00000000000000000000000000000000"
BOT_WEBHOOK_URL="https://bot.yourdomain.com/webhook"
MINIAPP_URL="https://miniapp.yourdomain.com"

# Storage
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="/app/uploads"
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""

# App
NODE_ENV="development"
LOG_LEVEL="debug"
API_PORT=3001
WEB_PORT=3000

# Bootstrap: Telegram IDs promoted to SUPER_ADMIN on boot (comma-separated)
BOOTSTRAP_ADMIN_IDS=""
